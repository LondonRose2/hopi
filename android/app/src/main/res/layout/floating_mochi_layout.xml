<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp">

    <!-- Avatar Container with Overdue Alert Dot -->
    <FrameLayout
        android:id="@+id/mochi_avatar_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <!-- Draggable Companion Avatar -->
        <ImageView
            android:id="@+id/mochi_image"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/mochi_avatar"
            android:contentDescription="Companion Avatar"
            android:scaleType="fitCenter" />

        <!-- Overdue Task Indicator Dot -->
        <View
            android:id="@+id/mochi_alert_dot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/alert_dot_bg"
            android:elevation="8dp"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Quick Action Menu (Transparent Container with Spaced Pills) -->
    <LinearLayout
        android:id="@+id/mochi_quick_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 1. Urgent Task Button (Dynamic Variable) -->
        <TextView
            android:id="@+id/btn_menu_urgent_task"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/quick_menu_btn_bg"
            android:textColor="#2D3748"
            android:textSize="13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:elevation="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:maxWidth="220dp"
            android:text="✅ Complete Task" />

        <!-- 2. Log Water Button -->
        <TextView
            android:id="@+id/btn_menu_water"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/quick_menu_btn_bg"
            android:textColor="#1E3A8A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:elevation="6dp"
            android:text="💧 Log Water" />

        <!-- 3. Add Task Button -->
        <TextView
            android:id="@+id/btn_menu_task"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/quick_menu_btn_bg"
            android:textColor="#C4704B"
            android:textSize="12sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:elevation="6dp"
            android:text="📝 Add Task" />

    </LinearLayout>

    <!-- Interactive Speech Bubble -->
    <TextView
        android:id="@+id/mochi_speech_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:maxWidth="220dp"
        android:background="@drawable/speech_bubble_bg"
        android:textColor="#2D3748"
        android:textSize="12sp"
        android:textStyle="bold"
        android:elevation="6dp"
        android:text="Hi Rachel! 💧"
        android:visibility="gone" />

</LinearLayout>
